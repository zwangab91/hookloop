# Brain: ONE of these
CLAUDE_CODE_OAUTH_TOKEN=   # your Claude subscription: run `claude setup-token` (Pro/Max/Ultra/Team/Enterprise)
ANTHROPIC_API_KEY=         # or pay-per-token API from platform.claude.com (used first if both are set)

# Research (Steps 2-4)
APIFY_TOKEN=            # TikTok + Instagram hashtag search
YOUTUBE_API_KEY=        # YouTube Shorts search
OPENAI_API_KEY=         # transcribe the first 10s of source videos (or research.transcriber: local)

# Publishing (Step 6)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=   # from `hookloop auth tiktok`
TIKTOK_REDIRECT_URI=    # https URI registered in your TikTok app
IG_USER_ID=
IG_ACCESS_TOKEN=        # long-lived token, see `hookloop auth instagram`
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=       # from `hookloop auth youtube`

# Encrypts rotated OAuth tokens inside state/hookloop.db (generate with `hookloop keygen`)
HOOKLOOP_STATE_KEY=

# Optional
ELEVENLABS_API_KEY=
SLACK_WEBHOOK_URL=
HOOKLOOP_WEBHOOK_URL=
HOOKLOOP_WEBHOOK_SECRET=
